	langid = {english},
	keywords = {Metabolism, Biochemical reaction networks, notion, Computational models},
	file = {Full Text PDF:/Users/emmatullius/Zotero/storage/Q7A8FP4I/Thiele und Palsson - 2010 - A protocol for generating a high-quality genome-scale metabolic reconstruction.pdf:application/pdf},
}

