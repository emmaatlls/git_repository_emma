	urldate = {2026-08-14},
	date = {2024-04-10},
	keywords = {notion, microbe-metabolite interdependency, root microbiota, spatial metabolite patterning, spatial rhizobiota organization, {SWEET} sugar transporter},
	file = {ScienceDirect Full Text PDF:/Users/emmatullius/Zotero/storage/3ZS7EJYX/Loo et al. - 2024 - Sugar transporters spatially organize microbiota colonization along the longitudinal root axis of i.pdf:application/pdf;ScienceDirect Snapshot:/Users/emmatullius/Zotero/storage/7ZT6XGMF/S193131282400057X.html:text/html},
