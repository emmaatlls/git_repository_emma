	keywords = {Bacterial Proteins, Culture Media, {CRISPR}-Cas Systems, Genome, Bacterial, notion, Genomics, Chromosomes, Bacterial, Clustered Regularly Interspaced Short Palindromic Repeats, Gene Knockdown Techniques, Gene Library, Vibrio},
