	langid = {english},
	keywords = {Microbial communities, Environmental microbiology, notion, Environmental sciences},
	file = {Full Text PDF:/Users/emmatullius/Zotero/storage/XYQGWE2K/Cui et al. - 2025 - Generalists and keystone species drive rhizosphere microbial diversity and stability in feral Brassi.pdf:application/pdf},
